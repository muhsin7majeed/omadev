#!/usr/bin/env python3
"""omadev command line entry point.

Lives inside the plugin directory so installing the plugin installs the CLI.
The widget invokes this file with an explicit `python3`, so the executable bit
is a convenience for terminal use rather than a requirement.
"""

import sys

if sys.version_info < (3, 11):
    sys.exit("omadev needs Python 3.11 or newer; found " + sys.version.split()[0])

from pathlib import Path

# The package sits one directory above this script; no installation step.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from omadev_cli.cli import main  # noqa: E402  (import after sys.path fix)

if __name__ == "__main__":
    sys.exit(main())
