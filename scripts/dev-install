#!/usr/bin/env bash
# Copy the working tree into the live Omarchy plugin directory and ask the
# shell to rescan. Copies rather than symlinks because the plugin validator
# rejects symlinks. Tests, scripts and the git history stay out of the copy.
set -euo pipefail

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
id=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["id"])' "$repo/manifest.json")
dest="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/$id"

omarchy plugin validate "$repo"

mkdir -p "$dest"
# Excluded paths are also protected from --delete on the receiving side, so a
# .git checkout in the destination survives.
rsync -a --delete \
  --exclude .git --exclude tests --exclude scripts \
  --exclude '__pycache__' --exclude '*.pyc' \
  "$repo/" "$dest/"

if omarchy-shell shell ping >/dev/null 2>&1; then
  omarchy-shell shell rescanPlugins
  echo "Installed to $dest and asked the shell to rescan"
else
  echo "Installed to $dest; the shell is not running, it will load the plugin on start"
fi
